<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Todo App</title>
    <link rel="stylesheet" type="text/css" href="~/css/main.css" />
    <link rel="stylesheet" type="text/css" href="~/css/home.css" />
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <header class="header">
        <div class="header-content">
          <img src="~/images/logo.png" alt="Todo Logo" class="logo" />
          <h1>Todo</h1>
        </div>
      </header>

      <!-- Main Content -->
      <main class="main-content">
        <!-- Create Todo Form -->
        <section class="create-section">
          <h2>Create New Todo</h2>
          <form id="createTodoForm" class="todo-form">
            <div class="form-group">
              <label for="title">Title *</label>
              <input
                type="text"
                id="title"
                name="title"
                required
                placeholder="Enter todo title"
                maxlength="50" />
            </div>

            <div class="form-group">
              <label for="description">Description *</label>
              <textarea
                id="description"
                name="description"
                required
                placeholder="Enter todo description"
                maxlength="100"
                rows="3"></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="priority">Priority *</label>
                <select id="priority" name="priority" required>
                  <option value="">Select priority</option>
                  <option value="1">Low (1)</option>
                  <option value="2">Medium (2)</option>
                  <option value="3">Normal (3)</option>
                  <option value="4">High (4)</option>
                  <option value="5">Critical (5)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="dueDate">Due Date</label>
                <input type="datetime-local" id="dueDate" name="dueDate" />
              </div>
            </div>

            <div class="form-group">
              <label for="tags">Tags (comma-separated, max 5)</label>
              <input
                type="text"
                id="tags"
                name="tags"
                placeholder="e.g. work, important, urgent" />
            </div>

            <button type="submit" class="btn btn-primary">Add Todo</button>
          </form>
        </section>

        <!-- Todo List Section -->
        <section class="list-section">
          <h2>My Todos</h2>
          <div class="filters">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="active">Active</button>
            <button class="filter-btn" data-filter="completed">Completed</button>
          </div>
          <div id="todoList" class="todo-list">
            <p class="loading">Loading todos...</p>
          </div>
        </section>
      </main>
    </div>

    <script src="~/js/main.js"></script>
  </body>
</html>
