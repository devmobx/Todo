@BASE_URL = https://localhost:7050/v1
@TODO_ID = 8c70fb25-9359-4453-be47-c66443e1577a
@REMINDER_ID = e1367a9d-8873-48f3-a329-b66e975dc1be

# Create Item
POST {{BASE_URL}}/item
Content-Type: application/json

{
"title": "Walk the dog",
"description": "Take the dog for a walk in the park",
"dueDate": "2025-12-11T10:00:00Z",
"priority": 1,
"tags": ["personal", "pets", "dogs", "lemons", "1234567891"]
}

###

# Get item
GET {{BASE_URL}}/item/{{TODO_ID}}
Accept: application/json

###

# Get all items
GET {{BASE_URL}}/items
Accept: application/json

###
# Update Item
PUT {{BASE_URL}}/item/{{TODO_ID}}
Content-Type: application/json

{
    "title": "Walk the dog - updated",
    "description": "Take the dog for a walk in the park - updated",
    "dueDate": "2024-13-01T11:00:00Z",
    "tags": ["personal", "pets", "exercise"]
}

###

# Remove Item
DELETE {{BASE_URL}}/item/{{TODO_ID}}

###

# Create reminder
POST {{BASE_URL}}/item/{{TODO_ID}}/reminder
Content-Type: application/json

{
"message": "Don't forget to walk the dog!",
"reminderDate": "2024-07-01T09:00:00Z"
}

###

# Get reminder
GET {{BASE_URL}}/item/{{TODO_ID}}/reminder/{{REMINDER_ID}}
Accept: application/json

###

# Get all reminders
GET {{BASE_URL}}/item/{{TODO_ID}}/reminders
Accept: application/json

###
# Update reminder
PUT {{BASE_URL}}/item/{{TODO_ID}}/reminder/{{REMINDER_ID}}
Content-Type: application/json

{
    "message": "Don't forget to walk the dog! - updated",
    "reminderDate": "2024-07-01T08:30:00Z"
}

###

# Remove Item
DELETE {{BASE_URL}}/item/{{TODO_ID}}/reminder/{{REMINDER_ID}}



