@{ ViewData["Title"] = "Reset Password"; }

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Todo App</title>
    <link rel="stylesheet" href="~/css/main.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
  </head>
  <body>
    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <img src="~/images/logo.png" alt="Todo App Logo" class="auth-logo" />
          <h1>Reset Password</h1>
          <p class="subtitle">We'll help you get back into your account</p>
        </div>

        <!-- Step 1: Request Reset -->
        <div id="requestResetStep" class="reset-step active">
          <form id="requestResetForm" class="auth-form">
            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <p class="form-description">
                Enter the email address associated with your account
              </p>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="you@example.com"
                required />
              <span class="error-message" id="emailError"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Send Reset Link</button>
          </form>

          <div class="auth-divider">
            <span>or</span>
          </div>

          <div class="auth-footer">
            <p class="footer-text">
              Remember your password?
              <a href="/login" class="auth-link">Sign in</a>
            </p>
          </div>
        </div>

        <!-- Step 2: Confirmation -->
        <div id="confirmationStep" class="reset-step" style="display: none">
          <div class="reset-confirmation">
            <div class="confirmation-icon">✓</div>
            <h2>Check Your Email</h2>
            <p>We've sent a password reset link to:</p>
            <p class="email-display" id="emailDisplay"></p>
            <p class="confirmation-text">
              Click the link in the email to reset your password. The link expires in 24
              hours.
            </p>
            <button
              type="button"
              class="btn btn-secondary"
              onclick="location.href='/login'">
              Return to Sign In
            </button>
            <p class="resend-text">
              Didn't receive the email?
              <button type="button" class="link-button" onclick="retryForgotPassword()">
                Try again
              </button>
            </p>
          </div>
        </div>

        <!-- Step 3: Reset Password (if token in URL) -->
        <div id="resetPasswordStep" class="reset-step" style="display: none">
          <form id="resetPasswordForm" class="auth-form">
            <input type="hidden" id="resetToken" name="resetToken" />

            <div class="form-group">
              <label for="newPassword" class="form-label">New Password</label>
              <input
                type="password"
                id="newPassword"
                name="newPassword"
                class="form-input"
                placeholder="••••••••"
                minlength="8"
                required />
              <span class="error-message" id="newPasswordError"></span>
              <small class="form-help">Minimum 8 characters</small>
            </div>

            <div class="form-group">
              <label for="confirmNewPassword" class="form-label">Confirm Password</label>
              <input
                type="password"
                id="confirmNewPassword"
                name="confirmNewPassword"
                class="form-input"
                placeholder="••••••••"
                required />
              <span class="error-message" id="confirmNewPasswordError"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Reset Password</button>
          </form>
        </div>

        <!-- Step 4: Success -->
        <div id="successStep" class="reset-step" style="display: none">
          <div class="reset-success">
            <div class="success-icon">✓</div>
            <h2>Password Reset Successful</h2>
            <p>
              Your password has been reset. You can now sign in with your new password.
            </p>
            <button
              type="button"
              class="btn btn-primary btn-lg"
              onclick="location.href='/login'">
              Sign In
            </button>
          </div>
        </div>
      </div>

      <div id="alertContainer"></div>
    </div>

    <script src="~/js/auth.js"></script>
    <script>
      // Check if there's a reset token in the URL
      const urlParams = new URLSearchParams(window.location.search);
      const resetToken = urlParams.get('token');

      if (resetToken) {
        document.getElementById('resetToken').value = resetToken;
        document.getElementById('requestResetStep').style.display = 'none';
        document.getElementById('resetPasswordStep').style.display = 'block';
        document
          .getElementById('resetPasswordForm')
          .addEventListener('submit', handleResetPassword);
      } else {
        document
          .getElementById('requestResetForm')
          .addEventListener('submit', handleRequestReset);
      }

      function retryForgotPassword() {
        document.getElementById('confirmationStep').style.display = 'none';
        document.getElementById('requestResetStep').style.display = 'block';
      }
    </script>
  </body>
</html>
