@model IEnumerable<Devmobx.Todo.Storage.Models.v1.TodoItem>
@{
    ViewData["Title"] = "My Todos";
}

<link rel="stylesheet" href="~/css/main.css" />
<link rel="stylesheet" href="~/css/auth.css" />
<link rel="stylesheet" href="~/css/todo.css" />

<div class="login-container todo-container">
    <!-- Header -->
    <div class="todo-header">
        <div class="login-logo">
            <span class="login-logo-text">✓</span>
        </div>
        <h1>My Todos</h1>
        <p class="login-subtitle">@User.Identity?.Name</p>
    </div>

    <!-- Add Todo Form -->
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <div class="todo-input-group">
                <input type="text" name="title" class="form-control" placeholder="What needs to be done?" required />
                <button type="submit" class="btn btn-primary btn-add">Add</button>
            </div>
        </div>
    </form>

    <!-- Todo List -->
    <div class="todo-list">
        @if (!Model.Any())
        {
            <div class="todo-empty">
                <p>No todos yet!</p>
                <span>Add your first task above</span>
            </div>
        }
        else
        {
            @foreach (var todo in Model)
            {
                <div class="todo-item @(todo.IsCompleted ? "completed" : "")">
                    <form asp-action="Toggle" method="post" class="todo-toggle-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <button type="submit" class="todo-checkbox @(todo.IsCompleted ? "checked" : "")">
                            @(todo.IsCompleted ? "✓" : "")
                        </button>
                    </form>

                    <span class="todo-title">@todo.Title</span>

                    <form asp-action="Delete" method="post" class="todo-delete-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@todo.Id" />
                        <button type="submit" class="todo-delete">×</button>
                    </form>
                </div>
            }
        }
    </div>

    <!-- Footer Stats -->
    @if (Model.Any())
    {
        <div class="todo-footer">
            <span>@Model.Count(t => !t.IsCompleted) remaining</span>
            <span>@Model.Count(t => t.IsCompleted) completed</span>
        </div>
    }

    <!-- Logout -->
    <div class="login-links">
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary">Sign Out</button>
        </form>
    </div>
</div>
