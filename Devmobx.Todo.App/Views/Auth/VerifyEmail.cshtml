@model VerifyEmailViewModel

@{
    ViewData["Title"] = "Verify Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Devmobx Todo</title>
    <link rel="stylesheet" href="~/css/main.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <span class="login-logo-text">Devmobx</span>
        </div>

        <h1>Verify Your Email</h1>
        <p class="login-subtitle">We've sent a verification code to <strong>@ViewBag.Email</strong></p>

        <form asp-controller="Auth" asp-action="VerifyEmail" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Code">Verification Code</label>
                <input asp-for="Code" class="form-control verification-code-input" 
                       placeholder="Enter code" autofocus autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="text-danger"></span>
                <small class="form-hint">Check your email inbox and spam folder</small>
            </div>

            <button type="submit" class="btn btn-primary">Verify & Create Account</button>
        </form>

        <div class="login-links">
            <p><a asp-controller="Auth" asp-action="Register">← Back to registration</a></p>
        </div>
    </div>
</body>
</html>
